@page "/food/{Id:int}"
@using SugboBites.Models
@using SugboBites.Services
@inject FoodGuideService FoodGuide
@inject NavigationManager Navigation
@inject FoodTrailState TrailState

@if (dish is null)
{
    <PageTitle>Dish not found | Sugbo Bites</PageTitle>
    <section class="empty-state"><span class="eyebrow">Food guide</span><h1>We couldn't find that dish</h1><p>It may have moved or the link may be incomplete.</p><a class="primary-action" href="/explore">Browse all dishes <span aria-hidden="true">→</span></a></section>
}
else
{
    <PageTitle>@dish.Name | Sugbo Bites</PageTitle>
    <div class="breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/explore">Explore food</a><span aria-hidden="true">/</span><span>@dish.Name</span></div>
    <article class="detail-layout">
        <div class="detail-image"><img src="@dish.ImageUrl" alt="@dish.ImageAlt" fetchpriority="high" /></div>
        <div class="detail-copy"><span class="eyebrow">@dish.Category</span><h1>@dish.Name</h1><p class="detail-description">@dish.Description</p><div class="detail-fact"><span>Where to look</span><strong>@dish.Location</strong></div><h2>A little context</h2><p>@dish.Story</p><button type="button" class="primary-action detail-save" @onclick="SaveDish" disabled="@TrailState.Contains(dish.Id)">@(TrailState.Contains(dish.Id) ? "Saved to your food trail ✓" : "＋ Save to my food trail")</button><TrailLifetimeNote /></div>
    </article>
    <section class="citation-card"><div><span class="eyebrow">Further reading</span><h2>Explore the destination</h2><p>Explore Cebu with @dish.SourceName.</p></div><a class="source-link" href="@dish.SourceUrl" target="_blank" rel="noopener noreferrer">Read more <span aria-hidden="true">↗</span></a></section>
    <div class="detail-back"><a href="/explore">← Back to all dishes</a><a href="/trail">View my food trail →</a></div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Dish? dish;

    protected override void OnParametersSet()
    {
        dish = FoodGuide.Find(Id);
        if (dish is not null && dish.Id != Id)
        {
            Navigation.NavigateTo($"/food/{dish.Id}", replace: true);
        }
    }

    private void SaveDish()
    {
        if (dish is not null) TrailState.Add(dish);
    }
}


