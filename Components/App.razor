@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#17483b" />
    <meta name="description" content="Explore Cebu's signature dishes, food traditions and places to taste the island." />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="SugboBites.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script>
        document.addEventListener('click', function (event) {
            if (event.target.closest('#blazor-error-ui .dismiss')) document.getElementById('blazor-error-ui').style.display = 'none';
        });
        window.addEventListener('blazor-error', function () {
            const notice = document.getElementById('blazor-error-ui');
            if (notice) notice.style.display = 'block';
        });
    </script>
</body>
</html>


